  "scripts": {
    "release": "standard-version",
    "ng": "ng",
    "start": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "extract-i18n": "ng xi18n --output-path src/i18n && xliffmerge --profile xliffmerge.json",
    "build-dev:en": "node --max_old_space_size=3072 ./node_modules/@angular/cli/bin/ng build --c=dev --i18n-locale en --i18n-format xlf --i18n-file src/i18n/messages.en.xlf --base-href=/en/ --deploy-url /en/ --output-path=Angular-build-project/en",
    "build-dev:de": "ng build --c=dev --i18n-locale de --i18n-format xlf --i18n-file src/i18n/messages.de.xlf --output-path=dist/de",
    "build-dev:fr": "ng build --c=dev --i18n-locale fr --i18n-format xlf --i18n-file src/i18n/messages.fr.xlf --output-path=dist/fr",
