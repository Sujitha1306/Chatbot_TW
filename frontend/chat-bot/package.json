    "build-lang-dev": "npm run build-dev:en && npm run build-dev:ar",
    "build-stage": "npm run build-stage:en && npm run build-stage:fr && npm run build-stage:de && npm run build-stage:ar",
    "build-demo": "npm run build-demo:en && npm run build-demo:fr && npm run build-demo:de && npm run build-demo:ar",
    "build-pre-prod": "npm run build-pre-prod:en && npm run build-pre-prod:fr && npm run build-pre-prod:de && npm run build-pre-prod:ar",
    "build-live": "npm run build-live:en && npm run build-live:fr && npm run build-live:de && npm run build-live:ar",
    "start-en": "ng serve --configuration=en --port=4202",
    "start-de": "ng serve --configuration=de --port=4203",
    "start-fr": "ng serve --configuration=fr --port=4204",
    "start-id": "node --max_old_space_size=5096 node_modules/@angular/cli/bin/ng serve -o --port 4205 --configuration=id",
    "start-ar": "node --max_old_space_size=5096 node_modules/@angular/cli/bin/ng serve -o --port 4205 --configuration=ar",
    "start-th": "node --max_old_space_size=5096 node_modules/@angular/cli/bin/ng serve -o --port 4205 --configuration=th",
    "post-build": "node ./build/post-build.js",
    "hash-build-check": "npm build && npm run build --configuration production && npm run post-build",
    "dev-locale": "node --max_old_space_size=8072 ./node_modules/@angular/cli/bin/ng build --localize --c=dev",
    "dev-hash-build": "node --max_old_space_size=8072 ./node_modules/@angular/cli/bin/ng build --c=dev --i18n-locale en --i18n-format xlf --i18n-file src/i18n/messages.en.xlf --base-href=/en/ --deploy-url /en/ --output-path=Angular-build-project/en && npm run post-build"
