    "build-stage:de": "ng build --c=stage --i18n-locale de --i18n-format xlf --i18n-file src/i18n/messages.de.xlf --output-path=dist/de",
    "build-stage:fr": "ng build --c=stage --i18n-locale fr --i18n-format xlf --i18n-file src/i18n/messages.fr.xlf --output-path=dist/fr",
