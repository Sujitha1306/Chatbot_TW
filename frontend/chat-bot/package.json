    "build-live:ar": "ng build --c=live --i18n-locale ar --i18n-format xlf --i18n-file src/i18n/messages.ar.xlf --output-path=dist/ar",
    "build-live:id": "ng build --c=live --i18n-locale id --i18n-format xlf --i18n-file src/i18n/messages.id.xlf --output-path=dist/id",
